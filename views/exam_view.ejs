<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Dashboard</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"></script>
</head>

<body>

<div class="m-4">

    <%- include("student_navbar") %>

    <div class="d-flex justify-content-end mb-4">
    <div id="timerCard" class="card shadow-sm border-10 rounded-4 px-4 py-3 text-center" style=" min-width:150px;
    background:#dbf9fa;transition:0.3s;">
        <div class="small text-uppercase text-muted fw-semibold mb-1">
            ⏱ Time Remaining
        </div>

        <div id="timer"
             class="fw-bold"
             style="font-size:2rem; color:#0d6efd; letter-spacing:2px;">
            00:00
        </div>
    </div>
</div>

    <<form id="examForm" method="post" action="/submit_ans">

    <input type="hidden" id="attemptId" value="<%= attemptId %>">

    <% let i = 1; %>

    <% data.forEach(function(e){ %>

        <input
            type="hidden"
            name="txt_<%= i %>"
            value="<%= e.ca %>">

        <div class="card shadow-sm border-0 rounded-4 mb-4">

            <div class="card-header bg-primary text-white py-3">
                <h5 class="mb-0">
                    Question <%= i %>
                </h5>
            </div>

            <div class="card-body" style="padding:30px;">

                <p class="fs-5 fw-semibold mb-4">
                    <%= e.question %>
                </p>

                <div class="form-check option-card mb-3">
                    <input
                        class="form-check-input"
                        type="radio"
                        name="ans_<%= i %>"
                        value="A"
                        data-question="<%= i %>"
                        data-correct="<%= e.ca %>"
                        <%= savedAnswers[i] === "A" ? "checked" : "" %>
                    >

                    <label class="form-check-label w-100">
                        <strong>A.</strong> <%= e.op1 %>
                    </label>
                </div>

                <div class="form-check option-card mb-3">
                    <input
                        class="form-check-input"
                        type="radio"
                        name="ans_<%= i %>"
                        value="B"
                        data-question="<%= i %>"
                        data-correct="<%= e.ca %>"
                        <%= savedAnswers[i] === "B" ? "checked" : "" %>
                    >

                    <label class="form-check-label w-100">
                        <strong>B.</strong> <%= e.op2 %>
                    </label>
                </div>

                <div class="form-check option-card mb-3">
                    <input
                        class="form-check-input"
                        type="radio"
                        name="ans_<%= i %>"
                        value="C"
                        data-question="<%= i %>"
                        data-correct="<%= e.ca %>"
                        <%= savedAnswers[i] === "C" ? "checked" : "" %>
                    >

                    <label class="form-check-label w-100">
                        <strong>C.</strong> <%= e.op3 %>
                    </label>
                </div>

                <div class="form-check option-card">
                    <input
                        class="form-check-input"
                        type="radio"
                        name="ans_<%= i %>"
                        value="D"
                        data-question="<%= i %>"
                        data-correct="<%= e.ca %>"
                        <%= savedAnswers[i] === "D" ? "checked" : "" %>
                    >

                    <label class="form-check-label w-100">
                        <strong>D.</strong> <%= e.op4 %>
                    </label>
                </div>

            </div>

        </div>

        <% i++; %>

    <% }); %>

    <div class="text-center my-5">
        <button
            type="submit"
            class="btn btn-success btn-lg px-5 rounded-pill shadow">
            ✔ Submit Assessment
        </button>
    </div>

</form>

</div>

<script>

const durationMinutes = Number("<%= remainingSeconds/60%>");
let timeLeft = durationMinutes * 60;

function updateTimer() {

    let min = Math.floor(timeLeft / 60);
    let sec = timeLeft % 60;

    document.getElementById("timer").innerHTML =
        `${min}:${sec.toString().padStart(2,'0')}`;

    if (timeLeft <= 60) {
        document.getElementById("timer").style.color = "red";
    }

    if (timeLeft <= 0) {
        document.getElementById("examForm").submit();
        return;
    }

    timeLeft--;
}

updateTimer();
setInterval(updateTimer, 1000);
const attemptId = document.getElementById("attemptId").value;

const radios = document.querySelectorAll("input[type='radio']");

radios.forEach(radio => {

    radio.addEventListener("change", function () {
         console.log("Radio changed");
        fetch("/save-answer", {

            method: "POST",

            headers: {
                "Content-Type": "application/json"
            },

            body: JSON.stringify({

                attemptId: attemptId,

                questionNo: this.dataset.question,

                selectedOption: this.value

            })

        })
        .then(res => res.json())
        .then(data => {
            console.log("Saved");
        })
        .catch(err => {
            console.log(err);
        });

    });

});
</script>
</body>
</html>
