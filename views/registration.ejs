<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Online Exam Portal</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body>
<div class="m-4">
    <%- include('navbar') %>
    <br>
 <div class="container d-flex justify-content-center align-items-center" style="min-height:85vh;">
    <div class="card shadow-lg border-0 rounded-4 p-4" style="width:550px;">
        <div class="text-center mb-4">
            <div style="font-size:55px;">📝</div>
            <h2 class="fw-bold">Create Account</h2>
            <p class="text-muted">
                Register to start your assessments.
            </p>
        </div>

        <form method="post" action="register">
            <div class="mb-3">
                <label class="form-label fw-semibold">Full Name</label>
                <input type="text"
                       class="form-control  rounded-pill"
                       name="Name"
                       placeholder="Enter your name">
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold">Institute Name</label>
                <input type="text"
                       class="form-control  rounded-pill"
                       name="InstituteName"
                       placeholder="Enter your institute name">
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold">Current Course</label>
                <select class="form-select  rounded-pill" name="course">
                    <option value="0">Select Course</option>
                    <option value="HigherSecondary">Higher Secondary</option>
                    <option value="B.Tech">B.Tech</option>
                    <option value="BCA">BCA</option>
                    <option value="B.Sc">B.Sc</option>
                    <option value="M.Tech">M.Tech</option>
                    <option value="MCA">MCA</option>
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold">Email</label>
                <input type="email"
                       class="form-control  rounded-pill"
                       name="Email"
                       placeholder="Enter your email">
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold">Address</label>
                <input type="text"
                       class="form-control  rounded-pill"
                       name="Address"
                       placeholder="Enter your address">
            </div>
            <div class="mb-4">
                <label class="form-label fw-semibold">Contact Number</label>
                <input type="text"
                       class="form-control  rounded-pill"
                       name="Contact"
                       placeholder="Enter your contact number">
            </div>
            <button type="submit"
                    class="btn btn-primary w-100 rounded-pill py-2">
                Register
            </button>
        </form>
        <hr>
        <div class="text-center">
            <span class="text-muted">Already have an account? </span>
            <a href="/Signin" class="fw-bold text-decoration-none">
                Sign In
            </a>
        </div>
    </div>
</div>

</div>
</form>
</div>
</div>
</body>
</html>