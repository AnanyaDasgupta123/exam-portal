<!DOCTYPE html>
<html lang="en">
<head>
  <title>Result</title>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
 <div class="m-4">
   <%- include('student_navbar',{username:uname}) %>
  </div>
<div class="container mt-5">

    <div class="card shadow-lg border-0 rounded-4">

        <div class="card-header bg-success text-white text-center py-4">
            <h2 class="mb-0">🎉 Assessment Completed</h2>
            <p class="mb-0 mt-2">Here is your performance summary</p>
        </div>

        <div class="card-body p-5">

            <div class="row text-center">

                <div class="col-md-3 mb-4">
                    <div class="stat-card correct" >
                        <h6>Correct</h6>
                        <h2><%= data.score %></h2>
                    </div>
                </div>

                <div class="col-md-3 mb-4">
                    <div class="stat-card incorrect" >
                        <h6>Incorrect</h6>
                        <h2><%= data.total_questions - data.score %></h2>
                    </div>
                </div>

                <div class="col-md-3 mb-4">
                    <div class="stat-card total">
                        <h6>Total Questions</h6>
                        <h2><%= data.total_questions %></h2>
                    </div>
                </div>

                <div class="col-md-3 mb-4">
                    <div class="stat-card percentage" >
                        <h6 style="font-size:15px;text-transform:uppercase;letter-spacing:1px;">Score</h6>
                        <h2 style=" margin-top:10px;font-size:35px;font-weight:bold;">
                            <%= ((data.score / data.total_questions) * 100).toFixed(2) %>%
                        </h2>
                    </div>
                </div>

            </div>

            <hr class="my-4">

            <div class="text-center">

                <h4 class="mb-4">
                    <% let percent=((data.score/data.total_questions)*100).toFixed(2); %>

                    <% if(percent>=80){ %>
                        🏆 Excellent Performance!
                    <% } else if(percent>=60){ %>
                        👍 Good Job!
                    <% } else if(percent>=40){ %>
                        🙂 Keep Practicing!
                    <% } else { %>
                        💪 Don't Give Up!
                    <% } %>
                </h4>

                <form method="get" action="/review_exam">

                    <button
                        class="btn btn-primary btn-lg rounded-pill px-5">

                        📖 Review Answers

                    </button>

                </form>

            </div>

        </div>

    </div>

</div>

</body>
</html>  