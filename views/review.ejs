<!DOCTYPE html>
<html lang="en">
<head>
  <title>Review </title>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body>
  <div class="m-4">
   <%- include('student_navbar',{username:uname}) %>
  </div>
    <br>
<div class="container mt-5">

    <h2 class="text-center mb-5">
        📖 Assessment Review
    </h2>

    <% data.forEach((e)=>{

        let correct = e.selected_answer == e.correct_answer;

    %>

    <div class="card shadow-sm border-0 rounded-4 mb-4">

        <div class="card-header d-flex justify-content-between align-items-center">

            <h5 class="mb-0">
                Question <%= e.question_no %>
            </h5>

            <% if(correct){ %>

                <span class="badge bg-success fs-6">
                    ✔ Correct
                </span>

            <% }else{ %>

                <span class="badge bg-danger fs-6">
                    ✖ Wrong
                </span>

            <% } %>

        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-6">

                    <h6 class="text-muted">
                        Your Answer
                    </h6>

                    <% if(e.selected_answer){ %>

                        <div class="answer-box bg-light">
                            <%= e.selected_answer %>
                        </div>

                    <% }else{ %>

                        <div class="answer-box bg-warning-subtle">
                            Not Answered
                        </div>

                    <% } %>

                </div>

                <div class="col-md-6">

                    <h6 class="text-muted">
                        Correct Answer
                    </h6>

                    <div class="answer-box bg-success-subtle">
                        <%= e.correct_answer %>
                    </div>

                </div>

            </div>

        </div>

    </div>

    <% }) %>

</div>