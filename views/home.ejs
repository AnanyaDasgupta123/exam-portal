<!DOCTYPE html>
 <html lang="en">
     <head> 
        <meta charset="utf-8"> <meta name="viewport" content="width=device-width, initial-scale=1">
         <title>Online Exam Portal</title>
          <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet"> 
          <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"></script> 
        </head>
         <body>
     <div class="m-4"> <%- include('navbar') %> <br>
<div class="container mt-4">
    <!-- Carousel -->
    <div id="myCarousel" class="carousel slide shadow rounded-4 overflow-hidden" data-bs-ride="carousel">
        <ol class="carousel-indicators">
            <li data-bs-target="#myCarousel" data-bs-slide-to="0" class="active"></li>
            <li data-bs-target="#myCarousel" data-bs-slide-to="1"></li>
            <li data-bs-target="#myCarousel" data-bs-slide-to="2"></li>
            <li data-bs-target="#myCarousel" data-bs-slide-to="3"></li>
        </ol>
        <div class="carousel-inner">
            <div class="carousel-item active">
                <img src="images/slide-1.jpg" class="d-block w-100" style="height:450px;object-fit:cover;">
            </div>
            <div class="carousel-item">
                <img src="images/slide-2.jpeg" class="d-block w-100" style="height:450px;object-fit:cover;">
            </div>
            <div class="carousel-item">
                <img src="images/slide-3.jpg" class="d-block w-100" style="height:450px;object-fit:cover;">
            </div>
            <div class="carousel-item">
                <img src="images/slide-4.jpg" class="d-block w-100" style="height:450px;object-fit:cover;">
            </div>
        </div>
        <a class="carousel-control-prev" href="#myCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon"></span>
        </a>
        <a class="carousel-control-next" href="#myCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon"></span>
        </a>
    </div>

    <!-- Hero Section -->
    <div class="text-center py-5">
        <h1 class="fw-bold display-5">
            Online Examination Portal
        </h1>
        <p class="lead text-muted mt-3">
            Practice technical interviews with timed assessments,
            real-world questions and instant evaluation.
        </p>
        <a href="/Signin" class="btn btn-primary btn-lg rounded-pill mt-3 px-4">
            Student Login
        </a>
        <a href="/Register" class="btn btn-outline-primary btn-lg rounded-pill mt-3 ms-2 px-4">
            Register
        </a>
    </div>
    <!-- Features -->
    <div class="row g-4 text-center mb-5">
        <div class="col-md-3">
            <div class="card shadow border-0 rounded-4 h-100">
                <div class="card-body">
                    <div style="font-size:45px;">📚</div>
                    <h5 class="fw-bold mt-3">
                        Multiple Subjects
                    </h5>
                    <p class="text-muted">
                        Practice Data Structures, DBMS,
                        Operating Systems,
                        Computer Networks and more.
                    </p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow border-0 rounded-4 h-100">
                <div class="card-body">
                    <div style="font-size:45px;">⏱</div>
                    <h5 class="fw-bold mt-3">
                        Timed Assessments
                    </h5>
                    <p class="text-muted">
                        Experience real placement-style
                        examinations with countdown timers.
                    </p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow border-0 rounded-4 h-100">
                <div class="card-body">
                    <div style="font-size:45px;">📊</div>
                    <h5 class="fw-bold mt-3">
                        Instant Results
                    </h5>
                    <p class="text-muted">
                        Get immediate scores
                        after submitting your assessment.
                    </p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow border-0 rounded-4 h-100">
                <div class="card-body">
                    <div style="font-size:45px;">🔄</div>
                    <h5 class="fw-bold mt-3">
                        Resume Exam
                    </h5>
                    <p class="text-muted">
                        Continue unfinished exams
                        without losing your progress.
                    </p>
                </div>
            </div>
        </div>
    </div>
    <!-- Statistics -->
    <div class="row text-center mb-5">
        <div class="col-md-4">
            <h2 class="fw-bold text-primary">
                9+
            </h2>
            <h5>Subjects</h5>
        </div>
        <div class="col-md-4">
            <h2 class="fw-bold text-primary">
                120+
            </h2>
            <h5>Questions</h5>
        </div>
        <div class="col-md-4">
            <h2 class="fw-bold text-primary">
                Timed
            </h2>
            <h5>Assessments</h5>
        </div>
    </div>
</div>